# Currency Symbol — full PKR formatting (comma grouping, decimal handling)
# is a separate decision at M55; this only fixes the displayed symbol.
NEXT_PUBLIC_CURRENCY_SYMBOL = 'Rs. '

# PostgreSQL connection string, read by Payload's Postgres adapter (ADR-010).
# Must match the credentials the `postgres` service in docker-compose.yml starts with.
DATABASE_URI=postgres://gocart:gocart@localhost:5432/gocart

# Secret Payload uses to sign auth tokens/cookies. Generate a real random value for
# every environment (e.g. `openssl rand -base64 32`) — never reuse this placeholder.
PAYLOAD_SECRET=changeme-generate-a-real-secret

# Optional overrides for the docker-compose `postgres` service. The values below are
# the defaults baked into docker-compose.yml; uncomment only to change them, and keep
# DATABASE_URI above in sync when you do.
# POSTGRES_USER=gocart
# POSTGRES_PASSWORD=gocart
# POSTGRES_DB=gocart
# POSTGRES_PORT=5432

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare Turnstile (M52b, ADR-035/036) ----------------------------------------------------
# A VERIFIED Turnstile token is required to place an order or look one up: without working keys
# nobody can order. Development/CI use Cloudflare's public always-pass TEST keys (they need network
# access to Cloudflare); production must use real keys and never the test ones (scripts/check-env.ts
# refuses them). NEXT_PUBLIC_* is inlined at build time, so changing the site key means rebuilding.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOW_TEST_KEYS=1

# Development only: lets the first /admin user be created on the create-first-user screen. Never set
# in production (check-env refuses it); the production admin is created from the two secrets below.
PAYLOAD_ALLOW_FIRST_REGISTER=1

# --- Free test deployment only: Vercel Hobby + Neon Free + Vercel Blob (M100, ADR-046) -------------
# Leave BLOB_READ_WRITE_TOKEN unset locally: media then stays on the local ./media volume (ADR-020).
# Vercel sets it when a Blob store is connected to the project; it enables the Vercel Blob adapter.
# The token format is vercel_blob_rw_<store_id>_<random>. Never commit a real value.
# BLOB_READ_WRITE_TOKEN=
# On Vercel, DATABASE_URI is Neon's pooled connection string for the restricted gocart_app role
# (never the owner role, ADR-036) and NEXT_PUBLIC_SITE_URL is the production *.vercel.app URL. See docs/DEPLOYMENT_VERCEL_TEST.md.

# --- Production only (docker-compose.prod.yml; see docs/DEPLOYMENT.md) -----------------------------
# APP_DB_PASSWORD         password of the restricted `gocart_app` database role the running app uses
#                         (>= 16 chars, A-Z a-z 0-9 - . _ ~, different from POSTGRES_PASSWORD).
# ADMIN_BOOTSTRAP_EMAIL / ADMIN_BOOTSTRAP_PASSWORD
#                         create the FIRST admin during the deploy migrate step. Required only while
#                         no user exists; remove both from the env file afterwards.
