{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout main:*)",
      "Bash(npm ci:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run test:env:*)",
      "Bash(npm run test:turnstile:*)",
      "Bash(npm run test:idempotency:*)",
      "Bash(npm run test:category-filters:*)",
      "Bash(npm run test:users-guard:*)",
      "Bash(npm run test:demo-images:*)",
      "Bash(npm run test:seo:*)",
      "Bash(npm run test:rollout-demo-photos)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker build:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm run seed:*)",
      "Bash(npm run test:rollout-demo-photos:db:*)",
      "Bash(npm run rollout:demo-photos:*)",
      "Bash(npx tsx scripts/rollout-demo-photos.ts:*)",
      "Bash(npx payload migrate:*)",
      "Bash(npm run deploy:migrate:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(rm -rf:*)",
      "Read(./.env.*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push -d:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git clean -xdf:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete --force:*)",
      "Bash(git tag -d:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune:*)",
      "Bash(dropdb:*)",
      "Bash(npm publish:*)",
      "Bash(git push origin +:*)",
      "Bash(git push origin ::*)",
      "Bash(git push -u origin +:*)",
      "Bash(git push -u origin ::*)",
      "Bash(git push -u origin HEAD:main:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --prune:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch --force:*)",
      "Bash(git checkout -f:*)",
      "Read(./.env)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(grep -r . .env:*)"
    ]
  }
}
