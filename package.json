{
  "name": "gocart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "check-env": "tsx scripts/check-env.ts",
    "test:env": "tsx scripts/check-env.test.ts",
    "test:turnstile": "tsx scripts/turnstile.test.ts",
    "test:idempotency": "tsx scripts/idempotency.test.ts",
    "test:users-guard": "tsx scripts/users-guard.test.ts",
    "deploy:migrate": "tsx scripts/check-env.ts && payload migrate && tsx scripts/db-roles.ts && tsx scripts/verify-migrations.ts && tsx scripts/bootstrap-admin.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@reduxjs/toolkit": "^2.8.2",
    "graphql": "^16.14.2",
    "lucide-react": "^0.525.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hot-toast": "^2.5.2",
    "react-redux": "^9.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "undici": "7.29.1"
  }
}
